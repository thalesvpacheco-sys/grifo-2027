{
  "name": "grifo-site",
  "version": "1.0.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "test": "node --test --experimental-strip-types --no-warnings \"tests/*.test.ts\"",
    "seed:reset": "node --experimental-strip-types scripts/reset-db.ts",
