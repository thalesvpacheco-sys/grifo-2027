# ───────── Grifo Agency — variáveis de ambiente ─────────
# Copie para .env.local (dev) ou configure no provedor de hospedagem.

# URL pública canônica (sem barra no final). Usada em canonical, sitemap, Open Graph e checagem de origem.
SITE_URL=https://grifo.agency

# Pasta persistente para banco SQLite e uploads. Em Docker/VPS aponte para um volume.
DATA_DIR=./data

# Segredo longo e aleatório (>= 32 chars). Assina tokens de formulário e pseudonimiza IPs.
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
APP_SECRET=

# Primeiro administrador (criado apenas se o banco não tiver usuários). Remova após o primeiro login.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrador

# true quando atrás de proxy/CDN confiável (Vercel, Cloudflare, Nginx) para ler o IP real em X-Forwarded-For.
TRUST_PROXY=true

# Exibir conteúdos marcados como "pendente de validação" (placeholders). Em produção deixe false.
CONTENT_SHOW_PLACEHOLDERS=false

# ───── Integração de leads (opcional) ─────
# Endpoint do CRM (RD Station, HubSpot, n8n, Make, Zapier…). Recebe POST JSON assinado com HMAC-SHA256.
CRM_WEBHOOK_URL=
CRM_WEBHOOK_SECRET=

# SMTP para aviso interno à equipe (roteamento por especialidade é configurado no painel).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Site Grifo <site@grifo.agency>"

# ───── Analytics (carregado somente após consentimento) ─────
# Pode ser definido também no painel em Configurações. O valor do painel tem prioridade.
NEXT_PUBLIC_GTM_ID=

# Token para a rota de manutenção /api/cron/retention (expurgo de leads conforme retenção LGPD).
CRON_SECRET=
